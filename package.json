{
  "name": "marketplace-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "check:env": "node scripts/check-env-example.mjs",
    "migrate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:revert -d dist/data-source.js",
    "migration:generate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:generate -d dist/data-source.js src/migrations/InitialSchema",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "demo:realtime:same-room": "node scripts/realtime-demo.mjs --same-room",
    "demo:publish": "bash scripts/with-secrets.sh dev node scripts/rabbit-demo.mjs publish",
    "demo:dlq": "bash scripts/with-secrets.sh dev node scripts/rabbit-demo.mjs dlq",
    "demo:duplicate": "bash scripts/with-secrets.sh dev node scripts/rabbit-demo.mjs duplicate",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "bundle:openapi": "redocly bundle openapi/openapi.yaml -o spec.json",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js test/integration --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js test/e2e --runInBand",
    "test:contract": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js test/contract/consumer --runInBand",
    "verify:provider": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js test/contract/provider --runInBand",
    "demo:cache": "bash scripts/with-secrets.sh dev node scripts/redis-cache-demo.mjs",
    "demo:session": "bash scripts/with-secrets.sh dev node scripts/redis-session-demo.mjs",
    "demo:ratelimit": "bash scripts/with-secrets.sh dev node scripts/redis-ratelimit-demo.mjs",
    "demo:queue": "bash scripts/with-secrets.sh dev node scripts/redis-queue-demo.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "amqplib": "^2.2.0",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4",
    "bullmq": "6.5.1",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "^2.46.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
