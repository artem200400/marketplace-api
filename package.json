{
  "name": "marketplace-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:dev": "ts-node src/main.ts",

    "check:env": "node scripts/check-env-example.mjs",

    "migrate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:revert -d dist/data-source.js",

    "migration:generate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:generate -d dist/data-source.js src/migrations/InitialSchema",

    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",

    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",

    "report": "bash scripts/with-secrets.sh dev node dist/report.js",

    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "bundle:openapi": "redocly bundle openapi/openapi.yaml -o spec.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}