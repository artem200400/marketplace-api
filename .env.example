# HTTP port for the application
PORT=3000

# PostgreSQL host
DB_HOST=localhost

# PostgreSQL port
DB_PORT=5432

# PostgreSQL database name
DB_NAME=marketplace

# PostgreSQL user
DB_USER=marketplace_user

# Path to the file containing the PostgreSQL password
DB_PASSWORD_FILE=secrets/db_password

# Database connection URL.
# Source: secret/configuration store
DB_URL=postgresql://marketplace_user:fake_password@127.0.0.1:6432/marketplace
DATABASE_URL=postgresql://marketplace_user:fake_password@127.0.0.1:6432/marketplace